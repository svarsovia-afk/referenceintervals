{
  "name": "Node.js 22",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  },
  "updateContentCommand": "npm install",
  "postAttachCommand": { "server": "npm run dev" },
  "portsAttributes": { "3000": { "label": "Application", "onAutoForward": "openPreview" } },
  "forwardPorts": [3000]
}
